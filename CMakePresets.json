{
  "version": 6,
  "configurePresets": [
    {
      "name": "shared",
      "hidden": true,
      "warnings": {
        "dev": false
      },
      "environment": {
        "PREFIX": "${sourceDir}/.pixi/envs/default",
        "LIBRARY_PREFIX": "${sourceDir}/.pixi/envs/default/Library"
      },
      "cacheVariables": {
        "MED_MEDINT_TYPE": "long long",
        "MEDFILE_INSTALL_DOC": "OFF",
        "MEDFILE_BUILD_PYTHON": "ON",
        "MEDFILE_BUILD_SHARED_LIBS": "ON",
        "MEDFILE_BUILD_STATIC_LIBS": "OFF",
        "CMAKE_FIND_ROOT_PATH_MODE_PROGRAM": "NEVER",
        "CMAKE_FIND_ROOT_PATH_MODE_LIBRARY": "ONLY",
        "CMAKE_FIND_ROOT_PATH_MODE_INCLUDE": "ONLY"
      }
    },
    {
      "name": "win-shared",
      "inherits": [
        "shared"
      ],
      "hidden": true,
      "environment": {
        "CFLAGS": "/nologo",
        "CXXFLAGS": "/nologo",
        "FCFLAGS": "/nologo /fpp /fixed /dll /MD /4I8 /4R8 /assume:byterecl,aligned_dummy_args,dummy_aliases,writeable_strings /4L132 /check:stack /check:bound /check:pointer /fpe:0"
      },
      "cacheVariables": {
        "MED_MEDINT_TYPE": "long long",
        "MEDFILE_BUILD_TESTS": "OFF",
        "CMAKE_VERBOSE_MAKEFILE": "ON",
        "MEDFILE_BUILD_CUSTOM_TESTS": "OFF",
        "CMAKE_INSTALL_PREFIX": "$env{LIBRARY_PREFIX}",
        "CMAKE_PREFIX_PATH": "$env{PREFIX};$env{LIBRARY_PREFIX};$env{LIBRARY_PREFIX}/include;$env{LIBRARY_PREFIX}/lib;$env{LIBRARY_PREFIX}/bin",
        "HDF5_ROOT_DIR": "$env{LIBRARY_PREFIX}"
      }
    },
    {
      "name": "win-msvc-llvm-flang",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "inherits": [
        "win-shared"
      ],
      "hidden": false,
      "environment": {
        "CC": "cl.exe",
        "CXX": "cl.exe",
        "FC": "flang-new.exe"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS": "/MD",
        "CMAKE_CXX_FLAGS": "/MD",
        "CMAKE_Fortran_FLAGS": "-fms-runtime-lib=dll"
      }
    },
    {
      "name": "win-msvc-intel-fortran-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "inherits": [
        "win-shared"
      ],
      "hidden": false,
      "environment": {
        "LDFLAGS": "/DEBUG /INCREMENTAL:NO"
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "Visual Studio (MSVC) with Intel Fortran"
        }
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_Fortran_FLAGS": "$env{FCFLAGS} /Od /debug /Zi /check:stack /check:bound /check:pointer /fpe:0 /traceback",
        "CMAKE_C_FLAGS": "$env{CFLAGS} /MDd /Od /Zi -DSWIG_PYTHON_INTERPRETER_NO_DEBUG=1",
        "CMAKE_CXX_FLAGS": "$env{CXXFLAGS} /MDd /Od /Zi -DSWIG_PYTHON_INTERPRETER_NO_DEBUG=1",
        "CMAKE_EXE_LINKER_FLAGS": "/DEBUG /INCREMENTAL:NO"
      }
    },{
      "name": "win-msvc-intel-fortran-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "inherits": [
        "win-shared"
      ],
      "hidden": false,
      "environment": {
        "CC": "cl.exe",
        "CXX": "cl.exe",
        "FC": "ifx.exe"
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "Visual Studio (MSVC) with Intel Fortran"
        }
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_Fortran_FLAGS": "$env{FCFLAGS}",
        "CMAKE_C_FLAGS": "$env{CFLAGS} /MD",
        "CMAKE_CXX_FLAGS": "$env{CXXFLAGS} /MD"
      }
    },
    {
      "name": "gcc-ninja-debug",
      "description": "Using gcc",
      "generator": "Ninja",
      "inherits": "shared",
      "hidden": false,
      "environment": {
        "INSTALL_PREFIX": "$env{MED_PREFIX}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_VERBOSE_MAKEFILE": "ON",
        "HDF5_ROOT_DIR": "$env{PREFIX}",
        "HDF5_VERSION": "1.14.4.3",
        "HDF5_INCLUDE_DIRS": "$env{PREFIX}/include",
        "MED_MEDINT_TYPE": "long",
        "CMAKE_PREFIX_PATH": "$env{PREFIX}:$env{PREFIX}/include:$env{PREFIX}/lib:$env{PREFIX}/bin",
        "CMAKE_FIND_ROOT_PATH": "$env{PREFIX}",
        "CMAKE_C_FLAGS": "-march=nocona -mtune=haswell -ftree-vectorize -fPIC -fstack-protector-strong -O0 -fno-plt -ffunction-sections -pipe -isystem $env{PREFIX}/include",
        "CMAKE_CXX_FLAGS": "-fvisibility-inlines-hidden -fmessage-length=0 -march=nocona -mtune=haswell -ftree-vectorize -fPIC -fstack-protector-strong -fno-plt -O0 -ffunction-sections -pipe -isystem $env{PREFIX}/include",
        "CMAKE_Fortran_FLAGS": "-fdefault-integer-8 -march=nocona -mtune=haswell -ftree-vectorize -fPIC -fstack-protector-strong -fno-plt -O0 -ffunction-sections -pipe -isystem $env{PREFIX}/include $env{FFLAGS}",
        "CMAKE_INSTALL_PREFIX": "$env{INSTALL_PREFIX}",
        "Python_FIND_VIRTUALENV": "FIRST",
        "Python_FIND_STRATEGY": "LOCATION",
        "Python_ROOT_DIR": "$env{PREFIX}"
      }
    }
  ]
}