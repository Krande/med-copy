{
  "version": 6,
  "include": [
    ".env.json"
  ],
  "configurePresets": [
    {
      "name": "shared",
      "hidden": true,
      "inherits": [
        "env-vars"
      ],
      "warnings": {
        "dev": false
      },
      "environment": {
        "PREFIX": "$env{MED_PREFIX}"
      },
      "cacheVariables": {
        "CMAKE_GENERATOR_PLATFORM": "",
        "CMAKE_GENERATOR_TOOLSET": "",
        "MEDFILE_INSTALL_DOC": "OFF",
        "MEDFILE_BUILD_PYTHON": "ON",
        "MEDFILE_BUILD_SHARED_LIBS": "ON",
        "MEDFILE_BUILD_STATIC_LIBS": "OFF",
        "CMAKE_FIND_ROOT_PATH_MODE_PROGRAM": "NEVER",
        "CMAKE_FIND_ROOT_PATH_MODE_LIBRARY": "ONLY",
        "CMAKE_FIND_ROOT_PATH_MODE_INCLUDE": "ONLY"
      }
    },
    {
      "name": "win-shared",
      "inherits": [
        "shared"
      ],
      "hidden": true,
      "environment": {
        "LIBRARY_PREFIX": "$env{PREFIX}/Library"
      },
      "cacheVariables": {
        "CMAKE_Fortran_COMPILER": "$env{FC}",
        "MED_MEDINT_TYPE": "long long",
        "CMAKE_C_FLAGS": "/MD",
        "CMAKE_CXX_FLAGS": "/MD",
        "CMAKE_PREFIX_PATH": "$env{PREFIX};$env{LIBRARY_PREFIX};$env{LIBRARY_PREFIX}/include;$env{LIBRARY_PREFIX}/lib;$env{LIBRARY_PREFIX}/bin",
        "HDF5_ROOT_DIR": "$env{LIBRARY_PREFIX}"
      }
    },
    {
      "name": "win-msvc-llvm-flang",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "inherits": [
        "win-shared"
      ],
      "hidden": false,
      "environment": {
        "CC": "cl.exe",
        "CXX": "cl.exe",
        "FC": "flang-new.exe"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS": "/MD",
        "CMAKE_CXX_FLAGS": "/MD",
        "CMAKE_Fortran_FLAGS": "-fms-runtime-lib=dll"
      }
    },
    {
      "name": "win-msvc-intel-fortran",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "inherits": [
        "win-shared"
      ],
      "hidden": false,
      "environment": {
        "LIBRARY_PREFIX": "$env{PREFIX}/Library",
        "CC": "cl.exe",
        "CXX": "cl.exe",
        "FC": "ifx.exe",
        "CFLAGS": "/0d /Zi",
        "CXXFLAGS": "/0d /Zi",
        "FFLAGS": "/Od /debug /Zi"
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "Visual Studio (MSVC) with Intel Fortran"
        }
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "$env{LIBRARY_PREFIX}",
        "CMAKE_Fortran_FLAGS": "/Od /debug /Zi /nologo /fpp /fixed /dll /MD /real-size:64 /integer-size:64",
        "CMAKE_C_FLAGS": "/nologo /Od /Zi -DSWIG_PYTHON_INTERPRETER_NO_DEBUG=1",
        "CMAKE_CXX_FLAGS": "/nologo /Od /Zi /EHsc -DSWIG_PYTHON_INTERPRETER_NO_DEBUG=1",
        "MEDFILE_BUILD_TESTS": "OFF",
        "CMAKE_VERBOSE_MAKEFILE": "ON",
        "CMAKE_EXE_LINKER_FLAGS": "/DEBUG /INCREMENTAL:NO",
        "MEDFILE_BUILD_CUSTOM_TESTS": "OFF"
      }
    },
    {
      "name": "gcc-ninja-debug",
      "description": "Using gcc",
      "generator": "Unix Makefiles",
      "inherits": "shared",
      "hidden": false,
      "environment": {
        "FC": "$env{PREFIX}/bin/x86_64-conda-linux-gnu-gfortran"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "$env{PREFIX};$env{PREFIX}/include;$env{PREFIX}/lib;$env{PREFIX}/bin;$env{PREFIX}/x86_64-conda-linux-gnu/sysroot/usr",
        "CMAKE_FIND_ROOT_PATH": "$env{PREFIX};$env{PREFIX}/x86_64-conda-linux-gnu/sysroot",
        "CMAKE_PROGRAM_PATH": "$env{PREFIX}/bin",
        "CMAKE_C_FLAGS": "-march=nocona -mtune=haswell -ftree-vectorize -fPIC -fstack-protector-strong -fno-plt -O2 -ffunction-sections -pipe -isystem $env{PREFIX}/include",
        "CMAKE_CXX_FLAGS": "-fvisibility-inlines-hidden -fmessage-length=0 -march=nocona -mtune=haswell -ftree-vectorize -fPIC -fstack-protector-strong -fno-plt -O2 -ffunction-sections -pipe -isystem $env{PREFIX}/include",
        "CMAKE_Fortran_FLAGS": "-fdefault-integer-8 -march=nocona -mtune=haswell -ftree-vectorize -fPIC -fstack-protector-strong -fno-plt -O2 -ffunction-sections -pipe -isystem $env{PREFIX}/include $env{FFLAGS}",
        "CMAKE_LINKER": "$env{PREFIX}/bin/x86_64-conda-linux-gnu-ld",
        "CMAKE_STRIP": "$env{PREFIX}/bin/x86_64-conda-linux-gnu-strip",
        "CMAKE_AR": "$env{PREFIX}/bin/x86_64-conda-linux-gnu-ar",
        "CMAKE_INSTALL_PREFIX": "$env{INSTALL_PREFIX}"
      }
    }
  ]
}